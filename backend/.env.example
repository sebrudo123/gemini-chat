# Copia este archivo a `.env` y rellena los valores.

# --- IA ---
AI_API_KEY=tu_api_key_de_google_gemini
AI_MODEL=gemini-3.5-flash
AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-flash-latest
AI_RETRIES=2

# --- Imágenes y RAG ---
# IMAGE_MODEL vacío usa Pollinations (gratis, sin clave ni registro).
# Si defines un modelo de imagen de Gemini, se usa ese (de pago) en su lugar.
IMAGE_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
RAG_ENABLED=true
RAG_TOP_K=4

# --- Sesiones ---
SESSION_SECRET=genera_una_cadena_aleatoria_larga
TOKEN_MAX_AGE=604800

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=tu_discord_client_id
DISCORD_CLIENT_SECRET=tu_discord_client_secret
DISCORD_REDIRECT_URI=https://tu-backend.onrender.com/api/auth/discord/callback

# --- Bot de Discord (opcional) ---
# Token del bot (Discord Developer Portal -> Bot -> Reset Token).
DISCORD_BOT_TOKEN=
# Opcional: ID del servidor para sincronizar los comandos al instante.
DISCORD_BOT_GUILD_ID=
# Opcional: IDs de canales permitidos, separados por comas. Vacío = todos.
DISCORD_BOT_CHANNEL_IDS=
# Arrancarlo al iniciar el backend. El panel permite apagarlo/encenderlo.
DISCORD_BOT_AUTOSTART=true
# Clave opcional para la URL pública /api/bot/wake. Vacío = derivada de SESSION_SECRET.
DISCORD_BOT_WAKE_KEY=

# --- Google OAuth2 eliminado: solo Discord y correo/contraseña ---

# --- Proveedores de login OAuth habilitados ---
# El login por correo/contraseña está siempre disponible (no se lista aquí).
AUTH_PROVIDERS=discord

# --- Administración ---
# IDs de Discord con acceso total al panel de administración.
FOUNDER_DISCORD_IDS=1439761085040427100
# Exige que el fundador tenga activada la verificación en dos pasos (2FA)
# antes de usar el chat. Si la desactiva, se vuelve a exigir.
FOUNDER_2FA_REQUIRED=true

# --- Correo transaccional ---
# Se prueban en orden: relevo HTTPS -> Brevo -> Resend -> SMTP.
# Opción A) Relevo HTTPS propio (recomendado sin dominio). Sirve un Google Apps
#   Script que reenvía desde tu Gmail; funciona donde SMTP está bloqueado (Render free).
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
# Opción B) Brevo (API HTTPS). Crea una API key en https://app.brevo.com.
BREVO_API_KEY=
# Opción C) Resend (API HTTPS). Necesita dominio verificado para enviar a terceros.
RESEND_API_KEY=
# Opción D) SMTP (solo si tu host permite SMTP saliente; Render gratis lo bloquea).
#   Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu@gmail.com
#          SMTP_PASSWORD=<contraseña de aplicación de Google>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Core IA <onboarding@resend.dev>
# Si es "true", los usuarios con correo sin verificar no podrán chatear.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_MAX_AGE=86400

# --- Autenticación en dos pasos (TOTP) ---
TOTP_ISSUER=Core IA
# Si es "true", se exige 2FA a todos (no recomendado durante la implantación).
REQUIRE_2FA=false
TWOFA_RECOVERY_CODES=10

# --- Frontend / CORS ---
FRONTEND_URL=https://tu-frontend.github.io/core-ia
ALLOWED_ORIGINS=https://tu-frontend.github.io,http://localhost:5500,http://127.0.0.1:5500

# --- Infraestructura ---
DATABASE_URL=postgresql://usuario:password@host:5432/coreia
REDIS_URL=
SENTRY_DSN=
ENVIRONMENT=development
RATE_LIMIT=30/minute
# Límite específico para login, registro y verificación 2FA (anti fuerza bruta).
AUTH_RATE_LIMIT=10/minute
METRICS_IP_ALLOWLIST=
METRICS_REQUIRE_ADMIN=false
BACKEND_URL=https://gemini-chat-backend-vyrz.onrender.com

