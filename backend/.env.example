# Copia este archivo a `.env` y rellena los valores.

# --- IA ---
AI_API_KEY=tu_api_key_de_google_gemini
AI_MODEL=gemini-3.8-flash
AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-flash-latest
AI_RETRIES=2

# --- Sesiones ---
SESSION_SECRET=genera_una_cadena_aleatoria_larga
TOKEN_MAX_AGE=604800

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=tu_discord_client_id
DISCORD_CLIENT_SECRET=tu_discord_client_secret
DISCORD_REDIRECT_URI=https://tu-backend.onrender.com/api/auth/discord/callback

# --- Frontend / CORS ---
FRONTEND_URL=https://tu-frontend.github.io/core-ia
ALLOWED_ORIGINS=https://tu-frontend.github.io,http://localhost:5500,http://127.0.0.1:5500
