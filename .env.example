# ==============================================================================
# CORE AI PLATFORM (V2) - CONFIGURACIÓN DE ENTORNO
# Arquitectura: Netlify + Servidor Privado de Inferencia + Supabase Cloud
# Cero dependencias de Gemini API ni proveedores de terceros.
# ==============================================================================

# --- SERVIDOR PRIVADO DE INFERENCIA (Proprietary Engine) ---
# URL base de tu servidor privado (ej. vLLM, Ollama, TGI, FastChat o API interna)
CORE_AI_ENDPOINT=https://tu-servidor-privado.com/v1

# Clave o token Bearer de acceso al servidor privado (dejar vacío si es red local/sin auth)
CORE_AI_API_KEY=tu_token_secreto_del_servidor_privado

# Identificador del modelo cargado en tu servidor privado
CORE_AI_MODEL=core-model-v2

# Parámetros de Inferencia
CORE_AI_TEMPERATURE=0.7
CORE_AI_MAX_HISTORY_TURNS=15
CORE_AI_MAX_RETRIES=2
CORE_AI_SYSTEM_PROMPT="Eres Core AI V2, una plataforma de inteligencia artificial propietaria y privada."

# --- PERSISTENCIA ATÓMICA EN SUPABASE ENTERPRISE CLOUD ---
# URL de tu instancia de Supabase (PostgreSQL Dialect)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave de API de Supabase (Anon Key o Service Role Key para acceso directo seguro)
SUPABASE_ANON_KEY=tu_supabase_anon_key_o_service_role

# --- FRONTEND & SEGURIDAD ---
# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=https://tu-app.netlify.app,http://localhost:8888,http://localhost:3000
