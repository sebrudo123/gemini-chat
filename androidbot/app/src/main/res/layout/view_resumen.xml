<?xml version="1.0" encoding="utf-8"?>
<!-- Resumen 100% nativo (item 1: app como tal). Datos por API
     /api/admin/discord-bot/app-home, sin WebView en esta pestaña. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15151f"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Estado del bot -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1b1b27"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#2b2b40"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_logo_circle"
                        android:contentDescription="@string/app_name"
                        android:padding="9dp"
                        android:src="@drawable/splash_logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/botName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#ffffff"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/botUptime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#7a7a92"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <View
                            android:id="@+id/botStateDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_ok" />

                        <TextView
                            android:id="@+id/botState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/botError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#ff8fa3"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hoy -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/resumen_hoy"
            android:textColor="#8f8fa8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1b1b27"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#2b2b40"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatTile">
                        <TextView
                            android:id="@+id/statMessages"
                            style="@style/StatValue" />
                        <TextView
                            android:text="@string/stat_messages"
                            style="@style/StatLabel" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatTile">
                        <TextView
                            android:id="@+id/statWelcomes"
                            style="@style/StatValue" />
                        <TextView
                            android:text="@string/stat_welcomes"
                            style="@style/StatLabel" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatTile">
                        <TextView
                            android:id="@+id/statVerifs"
                            style="@style/StatValue" />
                        <TextView
                            android:text="@string/stat_verifs"
                            style="@style/StatLabel" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatTile">
                        <TextView
                            android:id="@+id/statMods"
                            style="@style/StatValue"
                            android:textColor="#ffb457" />
                        <TextView
                            android:text="@string/stat_mods"
                            style="@style/StatLabel" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Servidores -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/resumen_servidores"
            android:textColor="#8f8fa8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1b1b27"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#2b2b40"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/guildList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Registro de moderación -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/resumen_modlog"
            android:textColor="#8f8fa8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1b1b27"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#2b2b40"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/modlogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/lastSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#4b4b63"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
