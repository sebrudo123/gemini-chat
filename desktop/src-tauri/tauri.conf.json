{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Core IA Studio",
  "version": "0.1.0",
  "identifier": "com.coreia.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Core IA Studio",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Chat de agentes de Core IA",
    "longDescription": "Core IA Studio es una app de escritorio para conversar con agentes de Core IA, gestionar sesiones y trabajar con archivos de tu equipo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
